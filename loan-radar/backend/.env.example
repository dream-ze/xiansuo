# ============================================
# 助贷线索雷达 - 环境变量配置
# ============================================
# 复制此文件为 .env 并根据环境修改配置
# cp .env.example .env

# --- 应用配置 ---
APP_NAME=Loan Radar Backend
APP_ENV=development
DEBUG=false

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg2://loan_radar:loan_radar_password@localhost:5432/loan_radar

# --- 安全 ---
# JWT 签名密钥，生产环境必须更换为随机强密钥（至少32字符）
# 可用命令生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-in-production-32ch
# Fernet 加密密钥（可选，不设置则从 SECRET_KEY 派生）
# 用于加密 Cookie 和 API Key
# 可用命令生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Token 过期时间 ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# 生产环境应仅包含实际域名，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# --- 调度器 ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- 素材存储 ---
ASSET_STORAGE_TYPE=local

# --- 前端静态服务（Docker/生产环境） ---
FRONTEND_SERVE_STATIC=false
FRONTEND_BUILD_DIR=./frontend/dist

# --- MediaCrawler 集成 ---

# 方式一：内嵌模式（推荐本地开发）
# 设置后 loan-radar 直接调用 MediaCrawler Python API，无需单独启动 HTTP 服务
# 需要先执行: pip install -e "./mediacrawler"
# 路径相对于 loan-radar 根目录，也可使用绝对路径
MEDIA_CRAWLER_HOME=./mediacrawler

# 方式二：HTTP Bridge 模式
# 不设置 MEDIA_CRAWLER_HOME 时自动使用此模式
# 需要单独启动 MediaCrawler API 服务: cd mediacrawler && uv run uvicorn api.main:app --port 8080
MEDIA_CRAWLER_API_URL=http://127.0.0.1:8080
MEDIA_CRAWLER_TIMEOUT=300

# 方式三：共享数据库（方案 B 增强）
# 直接读取 MediaCrawler 的 SQLite 数据库，跳过 HTTP API
# Docker 部署时自动配置
# MEDIA_CRAWLER_RAW_DB_PATH=/shared/mediacrawler/raw_tasks.sqlite3

# --- MediaCrawler 采集配置 ---
MEDIA_CRAWLER_COOKIES=
